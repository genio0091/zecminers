{
  "name": "@zecminers/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Scheduled jobs on pg-boss: reserve checks, PoR snapshots, pass owner checks, weekly payout cutoff/settlement, raffles.",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../web/.env.local src/index.ts",
    "start": "tsx src/index.ts",
    "once": "tsx --env-file-if-exists=../web/.env.local src/index.ts --once",
    "typecheck": "tsc -p tsconfig.json",
    "test": "echo \"worker: covered by @zecminers/db tests\""
  },
  "dependencies": {
    "@zecminers/db": "workspace:*",
    "@zecminers/zord-client": "workspace:*",
    "pg-boss": "^12.33.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
