# ───────────────────────── ZecMiners environment ─────────────────────────
# Copy to apps/web/.env.local for local dev. On Vercel, set these in Project → Settings → Env.
# Never commit real values. Secrets belong in Vercel / Doppler / 1Password (blueprint §11.1).

# Database — Neon via the Vercel integration sets these automatically.
DATABASE_URL=postgres://localhost:5432/zecminers_dev          # pooled (app)
DATABASE_URL_UNPOOLED=                                         # direct (migrations, worker)
DB_POOL_MAX=

# Auth.js v5 — `npx auth secret` generates AUTH_SECRET
AUTH_SECRET=
AUTH_URL=http://localhost:3000
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_DEV_LOGIN=true                   # local only; ignored when NODE_ENV=production
ADMIN_DISCORD_IDS=                    # comma-separated Discord user ids with admin role
ADMIN_IP_ALLOWLIST=                   # optional comma-separated IPs for /admin + /api/admin
MIN_DISCORD_ACCOUNT_AGE_DAYS=30

# Passes
CLAIM_CODE_PEPPER=                    # ≥16 random chars; required in production
MAX_PASSES_PER_ACCOUNT=1

# Chain — ZORD_MODE=mock runs everything against the database (dev); live talks to Zord + Zebra
ZORD_MODE=mock
ZCASH_NETWORK=mainnet
ZORD_API_URL=                         # e.g. http://10.8.0.1:3000 over WireGuard
ZORD_PATH_STATUS=                     # override API paths after verifying the Zord source at M0
ZORD_PATH_TOKEN=
ZORD_PATH_BALANCE=
ZORD_PATH_INSCRIPTION=
ZORD_PATH_UTXO=
ZEBRA_RPC_URL=
ZEBRA_RPC_USER=
ZEBRA_RPC_PASSWORD=

# Cloudflare Turnstile (login-adjacent actions, pass redeem, raffle tickets, waitlist)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Rate limiting (Upstash Redis works: rediss://default:…@….upstash.io:6379)
REDIS_URL=

# Scheduled jobs — Vercel Cron sends `Authorization: Bearer $CRON_SECRET`
CRON_SECRET=

# Media — after `pnpm --filter @zecminers/web media:upload` (Vercel Blob)
BLOB_READ_WRITE_TOKEN=
NEXT_PUBLIC_MEDIA_BASE_URL=

# Alerts (blueprint §11.3)
ALERT_DISCORD_WEBHOOK_URL=
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# Public site
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_DISCORD_URL=

# Signer host only (never on the web server)
SIGNER_DATABASE_URL=
SIGNER_MODE=dry-run
